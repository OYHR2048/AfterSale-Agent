# Set environment variables in your shell; no automatic .env loading.
AFTERSALE_RUNTIME_DIR=../aftersale-runtime
AFTERSALE_MODE=demo
# Only for model mode; NEVER commit a real key.
AFTERSALE_MODEL_BASE_URL=https://api.deepseek.com/v1
AFTERSALE_MODEL=deepseek-chat
AFTERSALE_ALLOW_MODEL=false
AFTERSALE_MODEL_CALL_LIMIT=40
# Optional retrieval-only adapter URL; no business writes are forwarded.
# AFTERSALE_RAG_URL=http://127.0.0.1:8020/policies/search
